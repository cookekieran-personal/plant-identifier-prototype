# Copy these names into Streamlit Community Cloud's Secrets box.
# Do not commit a real `.streamlit/secrets.toml` file.

PLANTNET_API_KEY = "replace-with-your-plantnet-key"
SUPABASE_URL = "replace-with-your-supabase-url"

# Prefer a read-only/read-insert key with RLS for public prototypes.
# SUPABASE_KEY can be an anon key if your Supabase policies allow the app's reads/inserts.
SUPABASE_KEY = "replace-with-your-supabase-key"

# Optional. Defaults to "prototype_evaluations".
SUPABASE_EVALUATIONS_TABLE = "prototype_evaluations"

