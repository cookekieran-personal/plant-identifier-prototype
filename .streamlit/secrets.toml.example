# Copy these names into Streamlit Community Cloud's Secrets box.
# Do not commit a real `.streamlit/secrets.toml` file.

PLANTNET_API_KEY = "replace-with-your-plantnet-key"

# Dear Garden Supabase is read-only for catalogue plants and image URLs.
SUPABASE_URL = "replace-with-your-deargarden-supabase-url"
SUPABASE_KEY = "replace-with-your-deargarden-read-only-supabase-key"

# Separate evaluation Supabase project for tester verdicts.
EVAL_SUPABASE_URL = "replace-with-your-evaluation-supabase-url"
EVAL_SUPABASE_KEY = "replace-with-your-evaluation-supabase-anon-key"
EVAL_SUPABASE_TABLE = "prototype_evaluations"